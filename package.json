{
  "name": "joincraft",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && npm run build:ui",
    "typecheck": "tsc --noEmit",
    "prestart": "npm run build",
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "npm run build && node --test test.mjs relay.test.mjs launcher.test.mjs",
    "backup": "node scripts/backup.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "desktop": "electron desktop/main.mjs",
    "test:launcher": "node --test launcher.test.mjs",
    "preview:launcher": "node scripts/preview-launcher.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.14.0",
    "@azure/msal-node": "^7.2.1",
    "@xmcl/core": "2.15.1",
    "fastify": "^5.12.8",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "electron": "^45.3.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "version": "0.9.0"
}
