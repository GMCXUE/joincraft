{
  "name": "joincraft",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && npm run build:ui",
    "typecheck": "tsc --noEmit",
    "prestart": "npm run build",
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "npm run build && node --test test.mjs desktop-login.test.mjs client-platform.test.mjs realtime.test.mjs interaction.test.mjs profile.test.mjs relay.test.mjs launcher.test.mjs community.test.mjs updater.test.mjs desktop-surfaces.test.mjs bundle-updater.test.mjs packs.test.mjs transfers.test.mjs pack-download.test.mjs http-client.test.mjs forge-installer.test.mjs download-gateway.test.mjs",
    "backup": "node scripts/backup.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "desktop": "electron .",
    "test:launcher": "node --test launcher.test.mjs",
    "preview:launcher": "node scripts/preview-launcher.mjs",
    "test:voice": "npm run build && node --test voice.integration.test.mjs",
    "voice:up": "node scripts/voice-local.mjs",
    "voice:down": "docker stop joincraft-voice-local",
    "test:updater": "node --test updater.test.mjs",
    "pack:desktop": "electron-builder --dir --publish never",
    "dist:win": "node scripts/build-installer.mjs",
    "dist:mac": "electron-builder --mac --arm64 --x64 --publish never",
    "dist:bundle": "node scripts/build-bundle.mjs",
    "test:bundle": "node --test bundle-updater.test.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:home": "node scripts/build-home.mjs",
    "preview:motion": "node scripts/preview-motion.mjs",
    "test:packs": "node --test --test-timeout=60000 packs.test.mjs transfers.test.mjs pack-download.test.mjs http-client.test.mjs forge-installer.test.mjs download-gateway.test.mjs",
    "test:packs:large": "npm run build && node --max-old-space-size=192 scripts/test-large-pack.mjs",
    "benchmark:packs": "node scripts/benchmark-pack-download.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.14.0",
    "@azure/msal-node": "^7.2.1",
    "@xmcl/core": "2.15.1",
    "@xmcl/installer": "6.1.2",
    "@xmcl/unzip": "2.1.2",
    "builder-util-runtime": "^9.7.0",
    "electron-updater": "^6.8.11",
    "fastify": "^5.12.8",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.3",
    "semver": "^7.8.6",
    "undici": "8.12.4",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@livekit/rtc-node": "^1.2.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  },
  "version": "0.9.23",
  "main": "desktop/main.mjs",
  "description": "joincraft Minecraft rooms and desktop launcher",
  "author": "GMCXUE",
  "overrides": {
    "@xmcl/installer": {
      "undici": "7.30.2"
    },
    "@xmcl/file-transfer": {
      "undici": "7.30.2"
    }
  }
}
