HOST=127.0.0.1
PORT=4180
DATABASE_PATH=./data/blockroom.sqlite
# 仅公网部署时配置，服务端验证 Host 与 Origin。使用已有 HTTPS 反向代理。
# PUBLIC_ORIGIN=https://mc.example.com
# 仅填写实际反向代理的 IP/CIDR；默认不信任 X-Forwarded-For。
# TRUST_PROXY=127.0.0.1
LOG_LEVEL=info

# 可选：语音。这里是内部 LiveKit 地址；客户端统一经过应用的 /voice 连接入口。
# 本地运行 npm run voice:up 后，取消以下三行注释即可。仅本机使用 devkey/secret。
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
# LIVEKIT_API_URL=http://127.0.0.1:7880
